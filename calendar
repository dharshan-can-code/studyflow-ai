"""
calendar_view.py - the calendar tab for StudyFlow AI.

The calendar is a live view of data the app already saves:
  - st.session_state.assignments -> all-day items on their due dates
  - st.session_state.study_plan  -> timed study sessions

Nothing new has to be stored. Dragging, adding, and deleting in the calendar edit
that same data, and the AI edits it through <add_session> / <move_session> tags
(the same tag trick the chatbot already uses for <add_assignment>).

Requires:  pip install streamlit-calendar
"""

import hashlib
import json
import re
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

import streamlit as st
from streamlit_calendar import calendar as st_calendar


